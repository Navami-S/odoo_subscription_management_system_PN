// Brightloop Subscription Management System
// Prisma Schema Definition

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  admin
  staff
  customer
}

enum BillingPeriod {
  daily
  weekly
  monthly
  yearly
}

enum PlanStatus {
  active
  paused
  closed
}

enum DiscountType {
  fixed
  percent
}

enum DiscountAppliesTo {
  product
  subscription
}

enum SubscriptionStatus {
  draft
  quotation
  confirmed
  active
  closed
}

enum InvoiceStatus {
  draft
  confirmed
  paid
  cancelled
}

enum PaymentMethod {
  cash
  card
  bank_transfer
  upi
  cheque
}

enum EmailStatus {
  pending
  sent
  failed
}

model User {
  id           Int      @id @default(autoincrement())
  email        String   @unique @db.VarChar(255)
  passwordHash String   @map("password_hash") @db.VarChar(255)
  role         UserRole @default(customer)
  isActive     Boolean  @default(true) @map("is_active")
  createdBy    Int?     @map("created_by")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  creator              User?                       @relation("UserCreator", fields: [createdBy], references: [id], onDelete: SetNull)
  createdUsers         User[]                      @relation("UserCreator")
  customer             Customer?
  passwordResetTokens  PasswordResetToken[]
  createdSubscriptions Subscription[]              @relation("SubscriptionCreator")
  statusHistory        SubscriptionStatusHistory[]
  recordedPayments     Payment[]
  auditLogs            AuditLog[]

  @@map("users")
}

model PasswordResetToken {
  id        Int       @id @default(autoincrement())
  userId    Int       @map("user_id")
  tokenHash String    @unique @map("token_hash") @db.VarChar(255)
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash, expiresAt])
  @@map("password_reset_tokens")
}

model Customer {
  id         Int      @id @default(autoincrement())
  userId     Int      @unique @map("user_id")
  name       String   @db.VarChar(255)
  phone      String?  @db.VarChar(50)
  company    String?  @db.VarChar(255)
  street     String?  @db.VarChar(255)
  city       String?  @db.VarChar(100)
  state      String?  @db.VarChar(100)
  postalCode String?  @map("postal_code") @db.VarChar(20)
  country    String?  @db.VarChar(100)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  subscriptions Subscription[]
  invoices      Invoice[]

  @@map("customers")
}

model Product {
  id         Int      @id @default(autoincrement())
  name       String   @db.VarChar(255)
  type       String   @db.VarChar(50)
  salesPrice Decimal  @map("sales_price") @db.Decimal(12, 2)
  costPrice  Decimal  @map("cost_price") @db.Decimal(12, 2)
  notes      String?  @db.Text
  isActive   Boolean  @default(true) @map("is_active")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  variants               ProductVariant[]
  quotationTemplateLines QuotationTemplateLine[]
  subscriptionLines      SubscriptionLine[]
  invoiceLines           InvoiceLine[]
  discountProducts       DiscountProduct[]

  @@map("products")
}

model ProductVariant {
  id         Int      @id @default(autoincrement())
  productId  Int      @map("product_id")
  attribute  String   @db.VarChar(100)
  value      String   @db.VarChar(100)
  extraPrice Decimal  @default(0.00) @map("extra_price") @db.Decimal(12, 2)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  product                Product                 @relation(fields: [productId], references: [id], onDelete: Cascade)
  quotationTemplateLines QuotationTemplateLine[]
  subscriptionLines      SubscriptionLine[]

  @@unique([productId, attribute, value])
  @@map("product_variants")
}

model Tax {
  id          Int      @id @default(autoincrement())
  name        String   @db.VarChar(100)
  ratePercent Decimal  @map("rate_percent") @db.Decimal(5, 2)
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  subscriptionLines SubscriptionLine[]

  @@map("taxes")
}

model PaymentTerm {
  id        Int      @id @default(autoincrement())
  name      String   @db.VarChar(100)
  dueDays   Int      @map("due_days")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  subscriptions Subscription[]

  @@map("payment_terms")
}

model Plan {
  id              Int           @id @default(autoincrement())
  name            String        @db.VarChar(255)
  price           Decimal       @db.Decimal(12, 2)
  billingPeriod   BillingPeriod @map("billing_period")
  minQuantity     Int           @default(1) @map("min_quantity")
  availableFrom   DateTime      @map("available_from")
  availableTo     DateTime?     @map("available_to")
  autoCloseOnEnd  Boolean       @default(true) @map("auto_close_on_end")
  closable        Boolean       @default(true)
  pausable        Boolean       @default(true)
  renewable       Boolean       @default(true)
  status          PlanStatus    @default(active)
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  quotationTemplates QuotationTemplate[]
  subscriptions      Subscription[]

  @@map("plans")
}

model Discount {
  id          Int               @id @default(autoincrement())
  name        String            @db.VarChar(255)
  type        DiscountType
  value       Decimal           @db.Decimal(12, 2)
  minPurchase Decimal?          @default(0.00) @map("min_purchase") @db.Decimal(12, 2)
  minQuantity Int?              @default(0) @map("min_quantity")
  startDate   DateTime?         @map("start_date")
  endDate     DateTime?         @map("end_date")
  usageLimit  Int?              @map("usage_limit")
  usedCount   Int               @default(0) @map("used_count")
  appliesTo   DiscountAppliesTo @map("applies_to")
  isActive    Boolean           @default(true) @map("is_active")
  createdAt   DateTime          @default(now()) @map("created_at")
  updatedAt   DateTime          @updatedAt @map("updated_at")

  discountProducts DiscountProduct[]
  invoiceDiscounts InvoiceDiscount[]

  @@map("discounts")
}

model DiscountProduct {
  discountId Int @map("discount_id")
  productId  Int @map("product_id")

  discount Discount @relation(fields: [discountId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([discountId, productId])
  @@map("discount_products")
}

model QuotationTemplate {
  id           Int      @id @default(autoincrement())
  name         String   @db.VarChar(255)
  planId       Int      @map("plan_id")
  validityDays Int      @default(30) @map("validity_days")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  plan  Plan                    @relation(fields: [planId], references: [id], onDelete: Restrict)
  lines QuotationTemplateLine[]

  @@map("quotation_templates")
}

model QuotationTemplateLine {
  id         Int      @id @default(autoincrement())
  templateId Int      @map("template_id")
  productId  Int      @map("product_id")
  variantId  Int?     @map("variant_id")
  quantity   Int      @default(1)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  template   QuotationTemplate       @relation(fields: [templateId], references: [id], onDelete: Cascade)
  product  Product                     @relation(fields: [productId], references: [id], onDelete: Restrict)
  variant  ProductVariant?             @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([templateId])
  @@index([productId])
  @@map("quotation_template_lines")
}

model Subscription {
  id              Int                @id @default(autoincrement())
  number          String             @unique @db.VarChar(50)
  customerId      Int                @map("customer_id")
  planId          Int                @map("plan_id")
  paymentTermId   Int                @map("payment_term_id")
  startDate       DateTime           @map("start_date")
  expiryDate      DateTime           @map("expiry_date")
  status          SubscriptionStatus @default(draft)
  nextBillingDate DateTime?          @map("next_billing_date")
  createdBy       Int?               @map("created_by")
  createdAt       DateTime           @default(now()) @map("created_at")
  updatedAt       DateTime           @updatedAt @map("updated_at")

  customer      Customer                    @relation(fields: [customerId], references: [id], onDelete: Restrict)
  plan          Plan                        @relation(fields: [planId], references: [id], onDelete: Restrict)
  paymentTerm   PaymentTerm                 @relation(fields: [paymentTermId], references: [id], onDelete: Restrict)
  creator       User?                       @relation("SubscriptionCreator", fields: [createdBy], references: [id], onDelete: SetNull)
  lines         SubscriptionLine[]
  statusHistory SubscriptionStatusHistory[]
  invoices      Invoice[]

  @@index([status, nextBillingDate])
  @@index([customerId])
  @@index([planId])
  @@map("subscriptions")
}

model SubscriptionLine {
  id             Int      @id @default(autoincrement())
  subscriptionId Int      @map("subscription_id")
  productId      Int      @map("product_id")
  variantId      Int?     @map("variant_id")
  quantity       Int      @default(1)
  unitPrice      Decimal  @map("unit_price") @db.Decimal(12, 2)
  taxId          Int?     @map("tax_id")
  amount         Decimal  @db.Decimal(12, 2)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  subscription Subscription    @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  product      Product         @relation(fields: [productId], references: [id], onDelete: Restrict)
  variant      ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  tax          Tax?            @relation(fields: [taxId], references: [id], onDelete: SetNull)

  @@index([subscriptionId])
  @@index([productId])
  @@map("subscription_lines")
}

model SubscriptionStatusHistory {
  id             Int                @id @default(autoincrement())
  subscriptionId Int                @map("subscription_id")
  fromStatus     SubscriptionStatus @map("from_status")
  toStatus       SubscriptionStatus @map("to_status")
  changedBy      Int?               @map("changed_by")
  changedAt      DateTime           @default(now()) @map("changed_at")

  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  user         User?        @relation(fields: [changedBy], references: [id], onDelete: SetNull)

  @@index([subscriptionId])
  @@index([changedAt])
  @@map("subscription_status_history")
}

model Invoice {
  id            Int           @id @default(autoincrement())
  number        String        @unique @db.VarChar(50)
  subscriptionId Int          @map("subscription_id")
  customerId    Int           @map("customer_id")
  periodStart   DateTime      @map("period_start")
  periodEnd     DateTime      @map("period_end")
  issueDate     DateTime      @map("issue_date")
  dueDate       DateTime      @map("due_date")
  status        InvoiceStatus @default(draft)
  subtotal      Decimal       @db.Decimal(12, 2)
  discountTotal Decimal       @default(0.00) @map("discount_total") @db.Decimal(12, 2)
  taxTotal      Decimal       @default(0.00) @map("tax_total") @db.Decimal(12, 2)
  total         Decimal       @db.Decimal(12, 2)
  amountPaid    Decimal       @default(0.00) @map("amount_paid") @db.Decimal(12, 2)
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  subscription Subscription      @relation(fields: [subscriptionId], references: [id], onDelete: Restrict)
  customer     Customer          @relation(fields: [customerId], references: [id], onDelete: Restrict)
  lines        InvoiceLine[]
  discounts    InvoiceDiscount[]
  payments     Payment[]

  @@unique([subscriptionId, periodStart])
  @@index([status, dueDate])
  @@index([customerId])
  @@index([subscriptionId])
  @@map("invoices")
}

model InvoiceLine {
  id              Int      @id @default(autoincrement())
  invoiceId       Int      @map("invoice_id")
  productId       Int      @map("product_id")
  description     String   @db.VarChar(255)
  quantity        Int
  unitPrice       Decimal  @map("unit_price") @db.Decimal(12, 2)
  taxRateSnapshot Decimal  @map("tax_rate_snapshot") @db.Decimal(5, 2)
  discountAmount  Decimal  @default(0.00) @map("discount_amount") @db.Decimal(12, 2)
  lineTotal       Decimal  @map("line_total") @db.Decimal(12, 2)
  createdAt       DateTime @default(now()) @map("created_at")

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([invoiceId])
  @@index([productId])
  @@map("invoice_lines")
}

model InvoiceDiscount {
  invoiceId  Int     @map("invoice_id")
  discountId Int     @map("discount_id")
  amount     Decimal @db.Decimal(12, 2)

  invoice  Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  discount Discount @relation(fields: [discountId], references: [id], onDelete: Restrict)

  @@id([invoiceId, discountId])
  @@map("invoice_discounts")
}

model Payment {
  id         Int           @id @default(autoincrement())
  invoiceId  Int           @map("invoice_id")
  method     PaymentMethod
  amount     Decimal       @db.Decimal(12, 2)
  paidOn     DateTime      @default(now()) @map("paid_on")
  note       String?       @db.Text
  recordedBy Int?          @map("recorded_by")
  createdAt  DateTime      @default(now()) @map("created_at")

  invoice  Invoice @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  recorder User?   @relation(fields: [recordedBy], references: [id], onDelete: SetNull)

  @@index([invoiceId])
  @@index([paidOn])
  @@map("payments")
}

model EmailOutbox {
  id        Int         @id @default(autoincrement())
  toEmail   String      @map("to_email") @db.VarChar(255)
  subject   String      @db.VarChar(255)
  body      String      @db.Text
  kind      String      @db.VarChar(50)
  sentAt    DateTime?   @map("sent_at")
  status    EmailStatus @default(pending)
  createdAt DateTime    @default(now()) @map("created_at")

  @@index([status])
  @@index([toEmail])
  @@map("email_outbox")
}

model AuditLog {
  id        Int      @id @default(autoincrement())
  userId    Int?     @map("user_id")
  action    String   @db.VarChar(50)
  entity    String   @db.VarChar(50)
  entityId  Int      @map("entity_id")
  details   String?  @db.Text
  createdAt DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([entity, entityId])
  @@map("audit_log")
}
